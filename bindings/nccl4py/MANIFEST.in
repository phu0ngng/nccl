# Include nccl package with all source files
recursive-include nccl *.py *.pyx *.pxd
recursive-include native/nccl_ep *

# Exclude directories not needed in sdist
prune tests
prune examples
prune build_assets
prune *.egg-info

# Exclude development files from root and subdirectoriese x
exclude Makefile
exclude uv.lock
global-exclude .gitignore .gitattributes

# Exclude compiled/generated files
global-exclude *.so
