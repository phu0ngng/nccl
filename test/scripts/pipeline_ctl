#!/bin/bash
#
# pipeline_ctl - Allow NCCL developers to manually control CI/CD pipelines
# Examples:
#   ./pipeline_ctl run -b my_feature_branch -t $GITLAB_API_TOKEN -v FOO=bar,BAZ=qux
#   ./pipeline_ctl cancel 123
#   ./pipeline_ctl delete 123
#   ./pipeline_ctl list

# GitLab variables
GITLAB_URL="https://gitlab-master.nvidia.com/api/v4/projects"
GITLAB_PROJECT_ID="34033"  # NCCL project ID
GITLAB_PAT=${GITLAB_API_TOKEN} # Populated from environment

# Print Usage
usage() {
  cat << EOF
Usage: ${script_name} COMMAND [OPTIONS]

Control GitLab CI/CD pipelines for NCCL development.

Commands:
  run              Run a new pipeline on the specified branch
  cancel <pid>     Cancel a running pipeline by pipeline ID
  delete <pid>     Delete a pipeline by pipeline ID
  list             List all pipelines

Options:
  -b, --branch BRANCH    Branch to run pipeline on (default: current branch)
  -v, --vars LIST        Comma-separated list of pipeline variables (VAR=VALUE,...)
  -d, --dry-run          Print configuration to terminal and exit

Custom Pipeline Options:
  -s, --system LIST      Comma-separated list of systems to run tests on (options: aws, eos, draco-oci, pre-nyx, pre-tyche, a100, a40, p100, p40, gp100, ipp6)
  -t, --test LIST        Comma-separated list of test types (options: unit-tests, api-tests, perf-tests-single, perf-tests-multiple)
  -B, --build SCRIPT     Custom build script path (unsupported)
  -S, --setup SCRIPT     Custom setup script path (unsupported)
  -R, --run SCRIPT       Custom run script path   (unsupported)

Unit test variables (default 1):
  ENQUEUE_TESTS_ARGS        Run enqueue tests with kernel args
  ENQUEUE_TESTS_FIFO        Run enqueue tests with FIFO
  GRAPH_TESTS_DEFAULT       Run graph tests with default settings
  MEMLEAK_TESTS_DEFAULT     Run memleak tests with default settings (default: 0 for a40, aws)
  MEMLEAK_TESTS_NO_P2P      Run memleak tests without P2P
  MEMLEAK_TESTS_NETWORK     Run memleak tests with network (default: 0 for a40, a100, aws)
  FT_TESTS_DEFAULT          Run ft tests with default settings
  FT_TESTS_NO_P2P           Run ft tests without P2P
  FT_TESTS_NETWORK          Run ft tests with network
  PLUGIN_TESTS_NET_TUNER    Run mixed plugin tests with net and tuner
  LOG_ALGO_RS_TESTS         Run PAT log algo rs tests
  LOG_ALGO_AG_TESTS         Run PAT log algo ag tests

Api test variables (default 1):
  API_TESTS_DEFAULT         Run api tests with default settings
  API_TESTS_NO_P2P          Run api tests without P2P
  API_TESTS_NETWORK         Run api tests with network

Pipeline variables:
  TRIGGER_PIPELINE        Trigger specific pipeline (unsupported)

Examples:
  ${script_name} run -b feature/my-branch
  ${script_name} cancel 123456
  ${script_name} list
  ${script_name} run -s aws,eos -t unit-tests,api-tests -b feature/my-branch

Environment:
  GITLAB_API_TOKEN    GitLab personal access token (required)
EOF
  exit 1
}

# Parse CLI arguments
script_name=$0
command=""
branch="$(git rev-parse --abbrev-ref HEAD)"
jobs=""
vars=""
build_script=""
setup_script=""
run_script=""
build_script_content=""
setup_script_content=""
run_script_content=""
pipeline_id=""
dry_run=""


# Run pipeline
run_pipeline() {
  branch_name=$1
  variable_list=$2

  # Build pipeline variables JSON
  variables=""
  if [[ ! -z "$variable_list" ]]; then
    # Convert comma-separated VAR=VALUE into JSON
    variables=",\"variables\":["
    IFS=',' read -ra var_array <<< "$variable_list"
    for i in "${var_array[@]}"; do
      IFS='=' read -r key value <<< "$i"
      variables+="{\"key\":\"$key\",\"value\":\"$value\"},"
    done
    variables=${variables%,}
    variables+="]"
  fi

  data="{\"ref\": \"${branch_name}\"${variables%,}}"
  if [[ "$dry_run" == "true" ]]; then
    echo "Dry run: would run pipeline with config:"
    echo "${data}" | jq .
    exit 0
  fi

  # Launch pipeline
  curl --silent --request POST \
    --header "PRIVATE-TOKEN: $GITLAB_PAT" \
    --header "Content-Type: application/json" \
    --data "${data}" \
    "$GITLAB_URL/$GITLAB_PROJECT_ID/pipeline" | jq .
}

# Cancel pipeline
cancel_pipeline() {
  pipeline_id=$1
  if [[ "$dry_run" == "true" ]]; then
    echo "Dry run: would cancel pipeline ${pipeline_id}"
    exit 0
  fi
  curl --silent --request POST \
    --header "PRIVATE-TOKEN: $GITLAB_PAT" \
    "$GITLAB_URL/$GITLAB_PROJECT_ID/pipelines/$pipeline_id/cancel" | jq .
}

# Delete pipeline
delete_pipeline() {
  pipeline_id=$1
  if [[ "$dry_run" == "true" ]]; then
    echo "Dry run: would delete pipeline ${pipeline_id}"
    exit 0
  fi
  curl --silent --request DELETE \
    --header "PRIVATE-TOKEN: $GITLAB_PAT" \
    "$GITLAB_URL/$GITLAB_PROJECT_ID/pipelines/$pipeline_id" | jq .
}

# List pipelines
list_pipelines() {
  if [[ "$dry_run" == "true" ]]; then
    echo "Dry run: would list pipelines"
    exit 0
  fi
  curl --silent --request GET \
    --header "PRIVATE-TOKEN: ${GITLAB_PAT}" \
    "$GITLAB_URL/$GITLAB_PROJECT_ID/pipelines" | jq .
}

while [[ $# -gt 0 ]] ; do
  case $1 in
    run|cancel|delete|list)
      if [[ ! -z "$command" ]]; then
        echo "Error: Only one command allowed"
        usage
      fi
      command="$1"
      shift 1
      if [[ "$command" == "cancel" || "$command" == "delete" ]]; then
        pipeline_id="$1"
        shift 1
      fi
      ;;
    -b|--branch)
      branch="$2"
      shift 2
      ;;
    -s|--system)
      avail_systems=( aws eos draco-oci pre-nyx pre-tyche a100 a40 p100 p40 gp100 ipp6 )
      target_systems="$2"
      local_vars=","
      IFS=',' read -ra systems <<< "$target_systems"
      for system in "${systems[@]}"; do
        if [[ ! "$system" =~ ^(aws|eos|draco-oci|pre-nyx|pre-tyche|a100|a40|p100|p40|gp100|ipp6)$ ]]; then
          echo "Error: invalid system '$system'"
          usage
        else
          system=$(echo "$system" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
          if [[ ! "$local_vars" =~ "RUN_ON_$system" ]] ; then
            local_vars+="RUN_ON_$system=1,"
          fi
        fi
      done
      # Disable systems not specified
      for system in "${avail_systems[@]}"; do
        system=$(echo "$system" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
        if [[ ! "$local_vars" =~ "RUN_ON_$system" ]] ; then
          local_vars+="RUN_ON_$system=0,"
        fi
      done
      local_vars=${local_vars%,}
      vars+=$local_vars
      vars=${vars#,}
      shift 2
      ;;
    -t|--test)
      avail_tests=( unit-tests api-tests perf-tests-single perf-tests-multiple )
      target_tests="$2"
      local_vars=","
      IFS=',' read -ra tests <<< "$target_tests"
      for test in "${tests[@]}"; do
        if [[ ! "$test" =~ ^(unit-tests|api-tests|perf-tests-single|perf-tests-multiple)$ ]]; then
          echo "Error: invalid test '$test'"
          usage
        else
          test=$(echo "$test" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
          if [[ ! "$local_vars" =~ "RUN_$test" ]] ; then
            local_vars+="RUN_$test=1,"
          fi
        fi
      done
      # Disable tests not specified
      for test in "${avail_tests[@]}"; do
        test=$(echo "$test" | tr '[:lower:]' '[:upper:]' | tr '-' '_')
        if [[ ! "$local_vars" =~ "RUN_$test" ]] ; then
          local_vars+="RUN_$test=0,"
        fi
      done
      local_vars=${local_vars%,}
      vars+=$local_vars
      vars=${vars#,}
      shift 2
      ;;
    -B|--build)
      build_script="$2"
      if [[ ! -f "$build_script" ]] ; then
        echo "Error: Build script file '$build_script' not found"
        exit 1
      fi
      build_script_content=$(cat "$build_script")
      echo "Warning: build script not yet supported, ignoring"
      shift 2
      ;;
    -S|--setup)
      setup_script="$2"
      if [[ ! -f "$setup_script" ]] ; then
        echo "Error: Setup script file '$setup_script' not found"
        exit 1
      fi
      setup_script_content=$(cat "$setup_script")
      echo "Warning: setup script not yet supported, ignoring"
      shift 2
      ;;
    -R|--run)
      run_script="$2"
      if [[ ! -f "$run_script" ]] ; then
        echo "Error: Run script file '$run_script' not found"
        exit 1
      fi
      run_script_content=$(cat "$run_script")
      echo "Warning: run script not yet supported, ignoring"
      shift 2
      ;;
    -v|--vars)
      vars+=",$2"
      vars=${vars#,}
      shift 2
      ;;
    -d|--dry-run)
      dry_run="true"
      shift 1
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "Error: invalid invocation"
      usage
      ;;
  esac
done

# Validate required args
if [[ -z "$GITLAB_PAT" ]]; then
  echo "Error: GitLab token required. Set GITLAB_API_TOKEN env var"
  exit 1
fi

# Handle pipeline commands
if [[ "$command" == "run" ]]; then
  run_pipeline "$branch" "$vars"
elif [[ "$command" == "cancel" ]]; then
  cancel_pipeline "$pipeline_id"
elif [[ "$command" == "delete" ]]; then
  delete_pipeline "$pipeline_id"
elif [[ "$command" == "list" ]] ; then
  list_pipelines
fi
