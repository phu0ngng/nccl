#ifndef __cuda_etbl_memmap_h__
#define __cuda_etbl_memmap_h__

#include "cuda.h"
#include "cuda_uuid.h"
#include "nvtypes.h"

#ifdef __cplusplus
extern "C" {
#endif // __cplusplus

typedef unsigned long long CUmemGenericAllocationHandle;

CU_DEFINE_UUID(CU_ETID_Memmap, 
    0x5a8f615b, 0x0212, 0x4768, 0x81, 0xe4, 0xa7, 0x76, 0x5a, 0xc9, 0xf3, 0x59);

/**
* Specifies the security 'scope' of the allocation, such that uses outside
* the given scope are disallowed.
*/
typedef enum CUmemAllocationScope_enum {
    /** The allocation will only be used within this process */
    CU_MEM_ALLOCATION_SCOPE_PROCESS  = 0x0,
    /** The allocation will be used by any other process on this OS */
    CU_MEM_ALLOCATION_SCOPE_OS       = 0x1,
    /** The allocation will be used by other operating systems operating on the same fabric interconnect */
    CU_MEM_ALLOCATION_SCOPE_FABRIC   = 0x2,
} CUmemAllocationScope;

typedef enum CUmemAllocationHandleType_enum {
    /* A POSIX-compliant file descriptor */
    CU_MEM_HANDLE_POSIX_FILE_DESCRIPTOR = 0x1ULL,
    /* A windows NT handle, usable with DuplicateObject, etc.  Requires the use
     * of an OS security descriptor \sa CUmemAllocationProp::win32HandleMetaData */
    CU_MEM_HANDLE_WIN32                 = 0x2ULL,
    /* A windows KMT handle */
    CU_MEM_HANDLE_WIN32_KMT             = 0x4ULL,
    /* A fabric handle */
    CU_MEM_HANDLE_FABRIC                = 0x8ULL
} CUmemAllocationHandleType;

/**
* Specifies the compression mechanism for this allocation
*/
typedef enum CUmemAllocationComp_enum {
    /** Default, no compression */
    CU_MEM_ALLOCATION_COMP_NONE     = 0x0,
} CUmemAllocationCompType;

/**
* Specifies the memory protection flags for mapping.
*/
typedef enum CUmemProt_enum {
    /** This virtual address range should be invalid for this mapping, and
     *  reads/writes to this virtual address range follow the same handling as
     *  a NULL or invalid pointer dereference */
    CU_MEM_PROT_NONE        = 0x0,
    /** This virtual address range should be marked as readable.  Any writes
     *  to this virtual address range without the WRITE flag follow the same
     * handling as writing to a NULL or invalid pointer */
    CU_MEM_PROT_READ        = 0x1,
    /** This virtual address range should be marked as both readable and
     * writable. */
    CU_MEM_PROT_READWRITE   = 0x3,
} CUmemProt;

/**
* \sa CUmemLocation
*/
typedef enum CUmemLocationType_enum {
    CU_MEM_LOCATION_TYPE_INVALID = 0x0,
    /** This location structure describes a location on the CPU */
    CU_MEM_LOCATION_TYPE_HOST    = 0x1,
    /** This location structure describes a location on a GPU */
    CU_MEM_LOCATION_TYPE_DEVICE  = 0x2,
} CUmemLocationType;

/**
* Defines the allocation types available
*/
typedef enum CUmemAllocationType_enum {
    CU_MEM_ALLOCATION_TYPE_INVALID = 0x0,
    /** This allocation is considered 'pinned', i.e. it must be resident while
    there is on-going gpu work */
    CU_MEM_ALLOCATION_TYPE_PINNED  = 0x1,
} CUmemAllocationType;

/**
* Flag for requesting different optimal and required granularities for an allocation.
* \sa MemGetAllocationGranularity, MemCreate
*/
typedef enum CUmemAllocationGranularityFlag_enum {
    /** Minimal granularity necessary for mappings */
    CU_MEM_ALLOC_GRANULARITY_MINIMUM     = 0x0,
    /** Recommended granularity for optimal performance */
    CU_MEM_ALLOC_GRANULARITY_RECOMMENDED = 0x1,
} CUmemAllocationGranularityFlag;

/**
* Properties for an allocation
* \sa CUmemAllocationProp
*/
typedef enum CUmemAllocationAttr_enum {
    CU_MEM_ALLOCATION_ATTR_INVALID                 = 0x0,
    /** Starting virtual address range for a mapped allocation (size: void*) */
    CU_MEM_ALLOCATION_ATTR_MAPPING_START_ADDR      = 0x1,
    /** Requested size of the allocation (size: size_t) */
    CU_MEM_ALLOCATION_ATTR_MAPPING_SIZE            = 0x2,
    /** Type of the location (\sa CUmemAllocationProp::location) (size: unsigned int) */
    CU_MEM_ALLOCATION_ATTR_MAPPING_TYPE            = 0x3,
    /** Location id of the allocation (\sa CUmemAllocationProp::location) (size: unsigned int) */
    CU_MEM_ALLOCATION_ATTR_MAPPING_ID              = 0x4,
    /** Enabled compression of the allocation (\sa CUmemAllocationProp::compression) (size: unsigned int) */
    CU_MEM_ALLOCATION_ATTR_MAPPING_COMPRESSION     = 0x5,
    /** Scope of the allocation (\sa CUmemAllocationProp::scope) (size: unsigned int) */
    CU_MEM_ALLOCATION_ATTR_MAPPING_SCOPE           = 0x6,
    /** Required granularity for this allocation (\sa MemGetAllocationGranularity) (size: size_t) */
    CU_MEM_ALLOCATION_ATTR_GRANULARITY_MINIMUM     = 0x7,
    /** Recommended granularity for this allocation (\sa MemGetAllocationGranularity) (size: size_t) */
    CU_MEM_ALLOCATION_ATTR_GRANULARITY_RECOMMENDED = 0x8,
} CUmemAllocationAttr;

typedef struct CUmemLocation_st {
    /** Specifies the location type, which modifies the meaning of id. \sa CUmemLocationType */
    CUmemLocationType type;
    int id;
} CUmemLocation;

/**
* Allocation properties.
* \sa MemCreate
*/
typedef struct CUmemAllocationProp_t {
    /** Type of allocation */
    CUmemAllocationType type;
    /** Scope of allocation (deprecated) */
    CUmemAllocationScope scope;
    /** Physical location description */
    CUmemLocation location;
    /** Compression type requested */
    CUmemAllocationCompType compression;
    /** Native access descriptor for specifying security information on
     *  supporting handle types. */
    void *win32HandleMetaData;
    /** Requested handle types to export \sa CUmemAllocationHandleType */
    unsigned long long requestedHandleTypes;
    /** Reserved for future use.  Must be zero. */
    unsigned long long reserved;
} CUmemAllocationProp;

/**
* Memory access descriptor
* \sa MemSetAccess
*/
typedef struct CUmemAccessDesc_st {
    /** Location to modify the access to */
    CUmemLocation location;
    /** CUmemProt flags to set for this location. \sa CUmemProt */
    unsigned int flags;
} CUmemAccessDesc;

/**
* Fabric handle
* \sa MemExportToShareableHandle, MemImportFromShareableHandle
*/
typedef struct CUmemFabricHandle_st {
    uint64_t data[128];
} CUmemFabricHandle;

typedef struct CUetblMemap_st {
    // This export table supports versioning by adding to the end without
    // changing the ETID.  The struct_size field will always be set to the
    // size in bytes of the entire export table structure.
    size_t struct_size;

    /**
    * \brief Allocate an address range reservation. 
    * 
    * Reserves a virtual address range based on the given parameters, giving
    * the starting address of the range in ptr.  This API requires a system that
    * supports UVA.  The size and address parameters must be a multiple of the
    * host page size and the alignment must be a power of two or zero for default
    * alignment.
    *
    * \param[out] ptr Resulting pointer to start of virtual address range allocated
    * \param[in]  size Size of the reserved virtual address range requested
    * \param[in]  alignment Alignment of the reserved virtual address range requested
    * \param[in]  addr Fixed starting address range requested
    * \param[in]  flags Currently unused, must be zero
    * \sa memAddressFree
    */
    CUresult (CUDAAPI *MemAddressReserve)(CUdeviceptr *ptr, size_t size, size_t alignment, const CUdeviceptr addr, unsigned long long flags);
    /**
    * \brief Free an address range reservation.
    * 
    * Frees a virtual address range reserved by memAddressReserve.  The size
    * must match what was given to memAddressReserve and the ptr given must
    * match what was returned from memAddressReserve.
    *
    * \param[in]  ptr Starting address of the virtual address range to free
    * \param[in]  size Size of the virtual address region to free
    * \sa memAddressReserve
    */
    CUresult (CUDAAPI *MemAddressFree)(CUdeviceptr ptr, size_t size);

    /**
    * \brief Creates a memory allocation with the specified properties.
    *
    * Creates a memory allocation with the specified properties and
    * associates the allocation with the virtual address range specified.  The
    * allocation will be released back to the OS when MemUnmap is called on the
    * full associated virtual address range.  The virtual address range specified
    * must be a virtual address range reserved via MemAddressReserve and must be
    * aligned to the minimum granularity that ::cuMemGetAllocationGranularity
    * called with CU_MEM_ALLOC_GRANULARITY_MINIMUM would give.  If the given
    * virtual address range has already been backed with a call to either
    * ::cuMemCreate or ::cuMemMap, this API will return an error.
    *
    * \param[in] ptr Virtual address to use when referring to this allocation
    * \param[in] size Size of the allocation to create
    * \param[in] prop Properties of the allocation to create
    * \param[in] flags For future use, must be zero
    * \sa MemAddressReserve, MemUnmap
    */
    CUresult (CUDAAPI *MemCreateAndMap)(CUdeviceptr ptr, size_t size, const CUmemAllocationProp *prop, unsigned long long flags);

    /**
    * \brief Unmap the backing memory of a given address range.
    * The range must be the entire contiguous address range that was mapped to.
    *
    * In other words, cuMemUnmap cannot unmap a sub-range of an address range
    * mapped by cuMemCreate / cuMemMap.
    *
    * The backing memory allocations will be freed if there are no existing
    * mapping in its scope, and there is no outstanding memory descriptors.
    *
    * When cuMemUnmap returns successfully the address range is converted to an
    * address reservation and can be used for a future mapping.
    *
    * Any new mapping to this virtual address will need to have access granted
    * through cuMemSetAccess, as all mappings start with no accessibility setup.
    *
    * This API may return asynchronous errors from previous API calls.
    *
    * \param[in] ptr Starting address for the virtual address range to unmap
    * \param[in] size Size of the virtual address range to unmap
    * \sa MemCreate, MemAddressReserve
    */
    CUresult (CUDAAPI *MemUnmap)(CUdeviceptr ptr, size_t size);

    /**
    * \brief Calculates either the minimal or recommended granularity 
    *
    * Calculates either the minimal or recommended granularity (\sa option)
    * for a given allocation specification and returns it in granularity.  This
    * granularity can be used as a multiple for alignment, size, or address mapping.
    *
    * \param[out] granularity Returned granularity.
    * \param[in]  prop Property for which to determine the granularity for
    * \param[in]  option Determines which granularity to return
    * \sa MemCreate
    */
    CUresult (CUDAAPI *MemGetAllocationGranularity)(size_t *granularity, const CUmemAllocationProp *prop, CUmemAllocationGranularityFlag option);

    /**
    * \brief Get the allocation property for the memory backing the given virtual address.
    *
    * \param[out] val Value of the property returned (size defined by property (\sa CUmemAllocationAttr)
    * \param[in]  ptr An address used to determine the allocation.  This address
    *                 must have a allocation backing it, such as that from MemCreate.
    * \param[in]  prop Property to query
    */
    CUresult (CUDAAPI *MemGetAllocationPropertyFromAddress)(void *val, const CUdeviceptr ptr, CUmemAllocationAttr prop);

    /**
    * \brief Set the access flags for each location specified in \p desc for the given virtual address range
    * 
    * Given the virtual address range via \p ptr and \p size, and the locations
    * in the array given by \p desc and \p count, set the access flags for the
    * target location.  The range must be a contiguous address range full
    * containing all allocations created by cuMemMap / cuMemCreate.  Specifying
    * a HOST location for a mapping will result in an error.
    *
    * This API may return asynchronous errors from previous API calls.
    * This API may synchronize with other calls submitted to that device.
    *
    * \param[in] ptr Starting address for the virtual address range
    * \param[in] size Length of the virtual address range
    * \param[in] desc Array of CUmemAccessDesc that describe how to change the
    *               mapping for each location specified
    * \param[in] count Number of CUmemAccessDesc in \p desc
    * \sa MemSetAccess, MemCreate, MemMap
    */
    CUresult (CUDAAPI *MemSetAccess)(CUdeviceptr ptr, size_t size, const CUmemAccessDesc *desc, size_t count);

    /**
    * \brief Get the access \p flags set for the given \p location and \p ptr
    *
    * \param[out] flags Flags set for this location
    * \param[in] location Location in which to check the flags for
    * \param[in] ptr Address in which to check the access flags for
    * \sa MemSetAccess
    */
    CUresult (CUDAAPI *MemGetAccess)(unsigned long long *flags, const CUmemLocation *location, CUdeviceptr ptr);
  
    /**
     * \brief Get the allocation property for the memory attributed to the shared memory handle. 
     *
     * \param[out] val   Value of the property returned (size defined by property (\sa CUmemAllocationAttr)
     * \param[in] handle An handle representing the allocation to the user. This handle must have been
     *  		  obtained by a previous call to MemCreate
     * \param[in] attr   Attribute to query 		  
     */
    CUresult (CUDAAPI *MemGetAllocationPropertyFromHandle)(void *val, const CUmemGenericAllocationHandle handle, CUmemAllocationAttr attr);

    /**
    * \brief Create a shareable memory handle representing a memory allocation of size \p size described by \p prop
    *
    * Creates a memory allocation on the target device specified through the \p prop strcuture. The created allocation will
    * not have any device or host mappings. Creates a generic memory handle for the allocation that can be mapped to the address
    * space of recepient process.
    *
    * The scope of the memory allocation (as specified in \p prop) must not be CU_MEM_ALLOCATION_SCOPE_PROCESS and the location
    * of the allocation must not be CU_MEM_LOCATION_TYPE_HOST. The handle can be mapped to an address range with cuMemMap.
    * This handle cannot be transmitted directly to other processes. The generic handle must be converted to OS native handles
    * for sharing the allocation with other processes. (\sa cuMemExportToOsNativeHandle cuMemImportFromOsNativeHandle
    * cuMemmap).
    *
    * On Windows, caller must pass security attribute to be associated with this handle which limits or allows access
    * to this handle for a recepient process.
    *
    * \param[out] handle Value of handle returned. All operations on this allocation are to be performed using this handle.
    * \param[in]  prop   Properties of the allocation to create.
    * \param[in]  flags  flags for future use, must be zero now.
    */
    CUresult (CUDAAPI *MemCreate)(CUmemGenericAllocationHandle *handle, size_t size, const CUmemAllocationProp *prop, unsigned long long flags);

    /**
    * \brief Release a memory handle representing a memory allocation which was previously allocated through cuMemCreate.
    * 
    * Frees the memory that was allocated on a device through cuMemCreate.
    *
    * The memory allocation will be freed when all outstanding mapping to the memory is freed and when the handle
    * and all outstanding conversions from all remote processes are released. The generic memory handle can be freed
    * when there are still outstanding mappings made with this handle. Each time a recepient process imports a shareable handle,
    * it needs to pair it with cuMemRelease for the handle to be freed.
    *
    * If the 'handle' passed by the caller is not a valid handle i.e. is not the same handle obtained from cuMemCreate the behavior is
    * undefined. 
    *
    * \param[in] handle Value of handle which was returned previously by cuMemCreate.
    * \sa cuMemCreate
    */
    CUresult (CUDAAPI *MemRelease)(CUmemGenericAllocationHandle handle);

    /**
    * \brief Maps memory represented by handle from offset \p offset
    * to address range [addr, addr + size]. This range must be an
    * address reservation previously reserved with
    * cuMemAddressReserve, and offset + size must be less than the
    * size of the memory allocation.
    * 
    * Note calling cuMemMap does not make the address accessible,
    * caller needs to update accessibility of contiguous mapped VA
    * range by calling cuMemSetAccess. Since, managed memory cannot
    * be shared, this function does not support managed memory.
    * 
    * Once a recepient process obtains a shareable memory handle
    * (\sa cuMemImportFromOSNativeHandle), the process must
    * use cuMemMap to map the memory into its address ranges before
    * setting accessibility with cuMemSetAccess.
    *  
    * cuMemMap can only create mappings on VA range reservations 
    * that are not currently mapped. 
    * 
    * \param[in] ptr    Address where memory will be mapped. 
    * \param[in] size   Size of the memory mapping. 
    * \param[in] offset Offset into the memory represented by 
    *                   \p handle from which to start mapping.
    * \param[in] handle Handle to a shareable memory 
    * \param[in] flags  flags for future use, must be zero now. 
    */
    CUresult (CUDAAPI *MemMap)(CUdeviceptr ptr, size_t size, size_t offset, CUmemGenericAllocationHandle handle, unsigned long long flags);

    /**
    * \brief Given a CUDA memory handle, create a shareable memory
    * allocation handle that can be used to share the memory with other
    * processes. The recipient process can convert the shareable handle back into a
    * CUDA memory handle using \sa cuMemImportFromShareableHandle and map
    * it with \sa cuMemMap. The implementation of what this handle is and how it
    * can be transferred is defined by the requested handle type in \p exportAttributes.
    *
    * Once all OS Native handles are closed and the allocation is released, the allocated
    * memory referenced will be released back(\sa cuMemRelease) to the OS and uses
    * of the CUDA handle will lead to undefined behavior.
    *
    * \param[out] shareableHandle Requested shareable handle.
    * \param[in] handle CUDA handle for the memory allocation.
    * \param[in] handleType Export time requested export attributes \sa CUmemAllocationHandleType
    * \param[in] flags Reserved, must be zero
    */
    CUresult (CUDAAPI *MemExportToShareableHandle)(void *shareableHandle, CUmemGenericAllocationHandle handle, CUmemAllocationHandleType handleType, unsigned long long flags);

    CUresult (CUDAAPI *MemImportFromShareableHandle)(CUmemGenericAllocationHandle *handle, void *shareableHandle, CUmemAllocationHandleType handleType);

} CUetblMemmap;

#ifdef __cplusplus
}
#endif // __cplusplus

#endif // file guard
