typedef enum CUtools_cbid_resource_internal_enum
{
    CU_TOOLS_CBID_RESOURCE_INTERNAL_INVALID                        = 0x000,
    CU_TOOLS_CBID_RESOURCE_INTERNAL_MEMBLOCK_ALLOC                 = 0x001,
    CU_TOOLS_CBID_RESOURCE_INTERNAL_MEMBLOCK_FREE                  = 0x002,
    CU_TOOLS_CBID_RESOURCE_INTERNAL_MEMOBJ_ALLOC                   = 0x003,
    CU_TOOLS_CBID_RESOURCE_INTERNAL_MEMOBJ_FREE                    = 0x004,
    CU_TOOLS_CBID_RESOURCE_INTERNAL_HOST_LOCAL_MEM_RESIZE          = 0x005,
    CU_TOOLS_CBID_RESOURCE_INTERNAL_DEVICE_LOCAL_MEM_RESIZE        = 0x006,
    CU_TOOLS_CBID_RESOURCE_INTERNAL_CRS_STACK_ALLOC                = 0x007,

    // --- always add new constants to the end here ---
    CU_TOOLS_CBID_RESOURCE_INTERNAL_SIZE,
    CU_TOOLS_CBID_RESOURCE_INTERNAL_FORCE_INT                      = 0x7fffffff
} CUtools_cbid_resource_internal;

typedef struct CUtoolsDriverMemoryDescriptor_st
{
    uint32_t struct_size;               // Size of struct
    uint16_t type;                      // Type of memory (enum type CUtoolsMemType)
    uint16_t api;                       // API used for the allocation (enum type CUtoolsMemApi)
    uint8_t  mapHost;                   // Whether this is mapped into host VA (enum type CUtoolsMemMapHost)
    uint8_t  mapDevice;                 // Whether this is mapped into device VA (enum type CUtoolsMemMapDevice)
    uint8_t  location;                  // Location of memory (enum type CUtoolsMemLocation)
    uint8_t  owner;                     // Owner of allocation (enum type CUtoolsMemOwner)
    uint8_t  userOwned;                 // Nonzero if user owns data for internal allocs
    uint8_t  userPortable;              // User requested portability
    uint8_t  hasDevPtr;                 // Is mapped into Dptr space (nonzero if true)
    uint8_t  reserved0;                 // Padding for 64 bit boundary
} CUtoolsDriverMemoryDescriptor;

// CU_TOOLS_CBID_RESOURCE_INTERNAL_MEMBLOCK_ALLOC
typedef struct CUtoolsMemBlockAlloc_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                      // size is sizeof(void*)
    CUtoolsMemBlockHandle hMemBlock;    // size is sizeof(void*)
    uint64_t allocationSize;            // size of allocation
    uint64_t devvaddr;                  // Device VA
    uint64_t devptr;                    // Device pointer (if mapped)
    uint64_t hostvaddr;                 // Host VA (if mapped)
    uint64_t dmalHandle;                // Opaque RM/MRM handle to memblock
    const CUtoolsDriverMemoryDescriptor *desc; // size is sizeof(void*)
    void* reserved1;                    // Pad to 64 bit boundary
    uint32_t deviceIdx;                 // Device on which the memblock was allocated
    uint32_t reserved2;                 // Padding
} CUtoolsMemBlockAlloc;

// CU_TOOLS_CBID_RESOURCE_INTERNAL_MEMBLOCK_FREE
typedef struct CUtoolsMemBlockFree_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                      // size is sizeof(void*)
    CUtoolsMemBlockHandle hMemBlock;    // size is sizeof(void*)
    uint64_t dmalHandle;                // Opaque RM/MRM handle to memblock
    const CUtoolsDriverMemoryDescriptor *desc; // size is sizeof(void*)
    void* reserved1;                    // Pad to 64 bit boundary
    uint32_t deviceIdx;                 // Device on which the memblock was allocated
    uint32_t reserved2;                 // Padding
} CUtoolsMemBlockFree;

// CU_TOOLS_CBID_RESOURCE_INTERNAL_MEMOBJ_ALLOC
typedef struct CUtoolsMemObjAlloc_st
{
    uint32_t struct_size;
    uint32_t reserved0;                 // for padding
    CUcontext ctx;                      // size is sizeof(void*)
    CUtoolsMemObjHandle hMemObj;        // size is sizeof(void*)
    CUtoolsMemBlockHandle hParentBlock; // size is sizeof(void*)
    const CUtoolsDriverMemoryDescriptor *desc; // size is sizeof(void*)
    uint64_t allocationSize;            // size of allocation
    uint64_t devvaddr;                  // Device VA
    uint64_t devptr;                    // Device pointer (if mapped)
    uint64_t hostvaddr;                 // Host VA (if mapped)
    uint64_t blockOffset;               // Offset from start of block
    uint64_t rangeOffset;               // Offset from start of range
} CUtoolsMemObjAlloc;

// CU_TOOLS_CBID_RESOURCE_INTERNAL_MEMOBJ_FREE
typedef struct CUtoolsMemObjFree_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                      // size is sizeof(void*)
    CUtoolsMemObjHandle hMemObj;        // size is sizeof(void*)
    CUtoolsMemBlockHandle hParentBlock; // size is sizeof(void*)
    const CUtoolsDriverMemoryDescriptor *desc; // size is aligned to 64 bits
} CUtoolsMemObjFree;

// CU_TOOLS_CBID_RESOURCE_INTERNAL_HOST_LOCAL_MEM_RESIZE
typedef struct CUtoolsHostLocalMemResize_st {
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                      // size is sizeof(void*)
    CUtoolsMemBlockHandle hMemBlock;    // size is sizeof(void*)
    CUtoolsMemObjHandle hMemObj;        // size is sizeof(void*)
    void* reserved1;                    // pad to 64 bit alignment
    uint64_t totalSize;                 // Total size of lmem
    uint64_t offset;                    // Offset of memobj in membloc
    uint64_t sizePerSM;                 // Local memory size per SM
} CUtoolsHostLocalMemResize;

// CU_TOOLS_CBID_RESOURCE_INTERNAL_DEVICE_LOCAL_MEM_RESIZE
typedef struct CUtoolsDeviceLocalMemResize_st {
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                      // size is sizeof(void*)
    CUtoolsMemBlockHandle hPoolMemBlock;    // size is sizeof(void*)
    CUtoolsMemObjHandle hPoolMemObj;    // size is sizeof(void*)
    void* reserved1;                    // pad to 64 bit alignment
    uint64_t poolOffset;                // Offset of memobj in membloc
    uint64_t slotSize;                  // Size of each slot
    uint64_t numSlots;                  // Number of slots
    uint64_t poolSize;                  // Size of the pool memobj
} CUtoolsDeviceLocalMemResize;

// CU_TOOLS_CBID_RESOURCE_INTERNAL_CRS_STACK_ALLOC
typedef struct CUtoolsCrsStackAlloc_st {
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                      // size is sizeof(void*)
    CUtoolsMemBlockHandle hMemBlock;    // size is sizeof(void*)
    CUtoolsMemObjHandle hMemObj;        // size is sizeof(void*)
    void* reserved1;                    // pad to 64 bit alignment
    uint64_t totalSize;                 // Total size of lmem
    uint64_t offset;                    // Offset of memobj in membloc
} CUtoolsCrsStackAlloc;

