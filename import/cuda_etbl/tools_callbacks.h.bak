typedef enum CUtools_patch_type_enum
{
    CU_TOOLS_PATCH_TYPE_INVALID       = 0x000, // Not a patch.  Ignore me.
    CU_TOOLS_PATCH_TYPE_BAR_WAR       = 0x001, // BAR.SYNC hang work-around.  bug 1806445
    // ---  add new CUDA Driver patches here ---

    CU_TOOLS_PATCH_TYPE_USER       = 0x1000, //
    // --- add new Tools-defined patches here ---

    CU_TOOLS_PATCH_TYPE_FORCE_INT               = 0x7fffffff
} CUtools_patch_type;

// CU_TOOLS_CBID_RESOURCE_FUNCTION_PATCHED
typedef struct CUtoolsFunctionPatched_st
{
    uint32_t struct_size;
    uint32_t reserved0;     // Pad to a 64-bit boundary

    CUcontext ctx;          // size is sizeof(void*)
    CUmodule mod;           // size is sizeof(void*)

    CUfunction srcFunc;     // The function that was patched.  (Cannot be NULL)
    CUfunction patchFunc;   // If the patch itself is a CUfunc, then this is that func.
                            // NOTE: this can be NULL.   Patches aren't guaranteed to
                            // be function objects.  

    uint64_t srcPC;         // PC within srcFunc where patch was inserted.
    uint64_t patchPC;       // PC of start of patch code.

    uint32_t patchSize;     // # of bytes in patch code
    uint32_t patchType;     // One of CUtools_patch_type enums

    // This union provides the original instruction at 'srcPC' before the patch was applied.
    union  {
        struct  {
          uint64_t shint;
          uint64_t inst;
        } kepler;
        struct  { // Maxwell and Pascal
          uint64_t opext;
          uint64_t inst;
        } maxwell;
        struct { // Volta+, where opext data is contained in each instruction
          uint64_t instLo;
          uint64_t instHi;
        } volta;
    } originalInst;

} CUtoolsFunctionPatched;

