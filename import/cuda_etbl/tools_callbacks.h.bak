    // the driver's implementation of the function will be skipped.  This is useful if
    // the tool wants to implement the function differently using the API enter callback.
    // The API exit callback is still called.
    uint32_t *skipInternalImplementation;

} CUtoolsTraceApiCudaEtbl;

