/// This callback is made if the user attempts to load a PTX module directly.
/// The client has an opportunity to inspect the PTX image, and add
/// extra JIT options as necessary.  This specifically allows JIT compiling
/// for debug.
/// http://nvbugs/675109
// CU_TOOLS_CBID_RESOURCE_MODULE_GET_JIT_EXTRA_OPTIONS
typedef struct CUtoolsModuleGetJitExtraOptions_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)

    /// pPtxImage points at the PTX text of the module, if available.
    const uint8_t *pPtxImage;
    const uint8_t *pUserJitOptions;

    /// pExtraOptions will be appended to/overriding the user's JIT options.
    /// This is an in/out parameter that clients should strncat to.
    uint8_t *pExtraOptions;
    size_t extraOptionsBufferLength;

    /// If callback sets *pExtraOptionsOverride to non-zero then
    /// pExtraOptions will override user's JIT options.  Otherwise
    /// pExtraOptions will be appended to the user's JIT options.
    uint32_t *pExtraOptionsOverride;
    
} CUtoolsModuleGetJitExtraOptions;

// CU_TOOLS_CBID_RESOURCE_MODULE_GET_JIT_LINK_EXTRA_OPTIONS
typedef struct CUtoolsModuleGetJitLinkExtraOptions_st
{
    uint32_t struct_size;
    uint32_t numOptions;
    CUcontext ctx;                     // size is sizeof(void*)

    // User's options and optionValues; callbacks should not modify these.
    // Modifying these values will have no effect on the linker's behavior.
    CUjit_option *options;
    void **optionValues;

    // If a callback sets this to true, then the linker will emit symbols of any
    // kind (line tables and/or full debug info) from input compilation units.
    // This does not control whether JIT compilation is in debug or produces line tables;
    // for that control, see CUtoolsModuleGetJitExtraOptions.
    uint32_t *emitSymbols;
} CUtoolsModuleGetJitLinkExtraOptions;

// CU_TOOLS_CBID_RESOURCE_CNP_UPDATE_CONSTANTS
typedef struct CUtoolsCnpUpdateConstants_st
{
    uint32_t struct_size;
    uint32_t padding0;

    CUcontext ctx;      // Size is sizeof (void*)
    void* padding1;     // Padding aligns the next 64 bit value to a 64 bit boundary

    // The device pointer to the base of the param bank pool.
    uint64_t paramBankPoolBase;
    uint64_t paramBankPoolSize;
} CUtoolsCnpUpdateConstants;

// CU_TOOLS_CBID_RESOURCE_MODULE_LOADED
typedef struct CUtoolsModuleLoaded_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)

    /// pPtxImage points at the PTX text of the module, if available.
    const char *pPtxImage;

    /// pCubin points at the cubin file contents (ELF file format).
    /// The cubin should always be valid, since this is what the driver executes.
    const void *pCubin;
    size_t cubinSize;

    /// pModuleName is a displayable name for the module.
    const char *pModuleName;

    /// If moduleOwner is driver, then it's a built-in module.  All modules
    /// loaded during context creation (including by tools!) and all hidden
    /// modules count as internal.  One of CUtoolsModuleOwner.
    uint32_t moduleOwner;
    uint32_t reserved1;

    /// moduleVisibility lets tools tell the difference between visible and
    /// hidden modules.  Simply checking for VISIBLE or not allows tools to
    /// have less brittle coupling with the driver, but if desired tools can
    /// also see which module it is.  One of CUtoolsModuleVisibility, or any
    /// greater value is possible in later driver versions.  Tools should
    /// assume unknown values are new hidden module types.
    uint32_t moduleVisibility;
    uint32_t reserved2;
} CUtoolsModuleLoaded;

