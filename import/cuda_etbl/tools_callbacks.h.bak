// Export table enter/exit callback params struct, shared by all
// callbacks in domain CU_TOOLS_CB_DOMAIN_TRACE_API_CUDA_ETBL
// e.g. CU_TOOLS_CBID_TRACE_API_CUDA_ETBL_ModuleLoadFatBinary.
typedef struct CUtoolsTraceApiCudaEtbl_st
{
    uint32_t struct_size;
    uint32_t apiEnterOrExit;   // Use values from CUtools_api_enter_exit

    // params is a different type for each function.  Cast to
