// Batch memory operations callbacks.
typedef enum CUtools_cbid_batch_memop_enum
{
    CU_TOOLS_CBID_BATCH_MEMOP_INVALID                       = 0x000,
    CU_TOOLS_CBID_BATCH_MEMOP_BEGIN                         = 0x001,
    CU_TOOLS_CBID_BATCH_MEMOP_END                           = 0x002,
    CU_TOOLS_CBID_BATCH_MEMOP_WRITE                         = 0x003,
    CU_TOOLS_CBID_BATCH_MEMOP_WAIT_BEGIN                    = 0x004,
    CU_TOOLS_CBID_BATCH_MEMOP_WAIT_END                      = 0x005,
    // --- always add new constants to the end here ---
    CU_TOOLS_CBID_BATCH_MEMOP_SIZE,
    CU_TOOLS_CBID_BATCH_MEMOP_FORCE_INT                     = 0x7fffffff
} CUtools_cbid_batch_memop;

typedef struct CUtoolsStreamBatchMemOpParams_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    union
    {
        uint32_t operation;

        struct CUtoolsStreamMemOpWaitValueParams_st
        {
            uint32_t operation; // CUstreamBatchMemOpType
            uint64_t address; // CUdeviceptr
            union
            {
                uint32_t value;
                uint64_t value64;
            };
            unsigned int flags;
            uint64_t alias; /**< For driver internal use. Initial value is unimportant. CUdeviceptr */
        } waitValue;

        struct CUtoolsStreamMemOpWriteValueParams_st
        {
            uint32_t operation; // CUstreamBatchMemOpType
            uint64_t address; // CUdeviceptr
            union
            {
                uint32_t value;
                uint64_t value64;
            };
            unsigned int flags;
            uint64_t alias; /**< For driver internal use. Initial value is unimportant. CUdeviceptr */
        } writeValue;

        struct CUtoolsStreamMemOpFlushRemoteWritesParams_st
        {
            uint32_t operation; // CUstreamBatchMemOpType
            unsigned int flags;
        } flushRemoteWrites;

        uint64_t pad[6];
    } params;
} CUtoolsStreamBatchMemOpParams;

// Used by all CU_TOOLS_CBID_BATCH_MEMOP callbacks
typedef struct CUtoolsBatchMemop_st
{
    uint32_t struct_size;
    uint32_t count; // Number of entries in 'params'

    CUcontext ctx;
    CUtoolsStreamBatchMemOpParams *params; // Array of CUtoolsStreamBatchMemOpParams structs. See 'count' to use it.
    CUtoolsStreamHandle stream;
    CUtoolsNvCurrent *pnvCurrent;
    CUtoolsChannelHandle hChannel;
    void* reserved0;

    uint32_t index; // Index of current 'params' entry, only for CU_TOOLS_CBID_BATCH_MEMOP{_WRITE, _WAIT_BEGIN, _WAIT_END}
    uint32_t status; // CUresult for operation result, only for CU_TOOLS_CBID_BATCH_MEMOP_END
} CUtoolsBatchMemop;

