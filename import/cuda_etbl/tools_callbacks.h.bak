// Init callbacks
typedef enum CUtools_cbid_init_enum
{
    CU_TOOLS_CBID_INIT_INVALID                         = 0x000,
    CU_TOOLS_CBID_INIT_INITIALIZE_STARTING             = 0x001,
    CU_TOOLS_CBID_INIT_BEFORE_DEVICE_REMAP             = 0x002,
    CU_TOOLS_CBID_INIT_AFTER_DEVICE_REMAP              = 0x003,
    CU_TOOLS_CBID_INIT_INITIALIZED                     = 0x004,
    CU_TOOLS_CBID_INIT_DEVICE_REMAP_BEGIN              = 0x005,
    CU_TOOLS_CBID_INIT_DEVICE_REMAP_PROGRESS           = 0x006,
    CU_TOOLS_CBID_INIT_DEVICE_REMAP_END                = 0x007,
    // --- always add new constants to the end here ---
    CU_TOOLS_CBID_INIT_SIZE,
    CU_TOOLS_CBID_INIT_FORCE_INT                       = 0x7fffffff
} CUtools_cbid_init;

// CU_TOOLS_CBID_INIT_BEFORE_DEVICE_REMAP
typedef struct CUtoolsBeforeDeviceRemap_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    // pRemapTable points at a table that can be modified by the client.
    // It may contain no duplicates.
    uint32_t *pRemapTable;
    size_t remapTableSize;
    uint32_t *pNewNumDevices;
    // If any callback sets *pRemappingHandled to a non-zero value, then
    // after the callback returns, the remapping specified in pRemapTable is
    // applied, and the default behavior of the driver is skipped.
    uint32_t *pRemappingHandled;
} CUtoolsBeforeDeviceRemap;

// CU_TOOLS_CBID_INIT_AFTER_DEVICE_REMAP
typedef struct CUtoolsAfterDeviceRemap_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    // pRemapTable points at a table that can be modified by the client.
    // It may contain no duplicates.
    uint32_t *pRemapTable;
    size_t remapTableSize;
    uint32_t *pNewNumDevices;
    // If any callback sets *pRemappingHandled to a non-zero value, then
    // after the callback returns, the remapping specified in pRemapTable is
    // applied, and remaining default behavior is skipped.
    uint32_t *pRemappingHandled;
} CUtoolsAfterDeviceRemap;

