// -----------------------------------------------------------------------------
// CU_TOOLS_CB_DOMAIN_PROFILER
// -----------------------------------------------------------------------------

// CUDA Profiler callbacks.
typedef enum CUtools_cbid_profiler_enum
{
    CU_TOOLS_CBID_PROFILER_INVALID                     = 0x000,
    CU_TOOLS_CBID_PROFILER_LAUNCH                      = 0x001,
    CU_TOOLS_CBID_PROFILER_MEMCPY                      = 0x002,
    CU_TOOLS_CBID_PROFILER_RECORD_FLUSH_STARTING       = 0x003,
    CU_TOOLS_CBID_PROFILER_RECORD_FLUSH_COMPLETED      = 0x004,
    // --- always add new constants to the end here ---
    CU_TOOLS_CBID_PROFILER_SIZE,
    CU_TOOLS_CBID_PROFILER_FORCE_INT                   = 0x7fffffff
} CUtools_cbid_profiler;

// CU_TOOLS_CBID_PROFILER_LAUNCH
typedef struct CUtoolsProfilerLaunch_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    uint64_t contextId;            // Incrementing ID, unique per process
    uint64_t streamId;             // Incrementing ID, unique per context
    uint64_t apiCallId;            // DEPRECATED - This parameter will not be set
    uint64_t startTime;            // NV01TIMER timestamp, nanoseconds since reset
    uint64_t endTime;              // NV01TIMER timestamp, nanoseconds since reset

    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)

    const char *methodName;           // Only guaranteed to be valid during callback
    const uint32_t *counterValues;    // List of counter data
    const char **counterNames;        // List of counter names

    uint32_t moduleId;             // Incrementing ID, unique per context
    uint32_t functionId;           // Incrementing ID, unique per module
    uint32_t blockSizeX;
    uint32_t blockSizeY;
    uint32_t blockSizeZ;
    uint32_t gridSizeX;
    uint32_t gridSizeY;
    uint32_t registerPerThread;
    uint32_t staticSharedMemPerBlock;
    uint32_t dynamicSharedMemPerBlock;
    uint32_t counters;                 // Number of attached hardware counters
    uint32_t underLoaderLock;          // Called under DllMain on Windows

    float occupancy;
    
    uint32_t cacheConfigRequested;     // Cache configuration set for the function
    uint32_t cacheConfigExecuted;      // Cache configuration used for execution
    uint32_t cacheConfigChanged;       // Flag set in case configuration needed to change

    uint32_t lmemPerThread;            // Local memory requested by the function
    uint32_t lmemTotal;                // Total amount of local memory required to execute

    uint32_t gridSizeZ;

    CU_32_BIT_PAD_ON_64_BIT_BUILDS(reserved1)

} CUtoolsProfilerLaunch;

// CU_TOOLS_CBID_PROFILER_MEMCPY
typedef struct CUtoolsProfilerMemcpy_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    uint64_t contextId;             // Incrementing ID, unique per process
    uint64_t streamId;              // Incrementing ID, unique per context
    uint64_t apiCallId;             // DEPRECATED - This parameter will not be set
    uint64_t startTime;             // NV01TIMER timestamp, nanoseconds since reset
    uint64_t endTime;               // NV01TIMER timestamp, nanoseconds since reset
    uint64_t memTransferSize;       // Number of bytes transferred

    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)

    uint32_t memTransferSrcType;    // Use CUmemorytype + pinned flag (0x100)
    uint32_t memTransferDstType;    // Use CUmemorytype + pinned flag (0x100)
    uint32_t memTransferAsyncCall;  // Bool, nonzero if memcpy was expected to support overlap
    uint32_t memTransferAsyncExec;  // Bool, nonzero if memcpy actually supported overlap
    uint32_t underLoaderLock;       // Called under DllMain on Windows
    uint32_t reserved1;

} CUtoolsProfilerMemcpy;

