{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;
    CUtoolsStreamHandle stream;
    CUgraph graph;
    void *reserved1;
} CUtoolsStreamCaptureBegin;

// CU_TOOLS_CBID_STREAM_CAPTURE_END
typedef struct CUtoolsStreamCaptureEnd_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;
    CUtoolsStreamHandle stream;
    CUgraph graph;
    void *reserved1;
} CUtoolsStreamCaptureEnd;

// CU_TOOLS_CBID_STREAM_CAPTURE_TRANSITIVE_BEGIN
typedef struct CUtoolsStreamCaptureTransitiveBegin_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;
    CUtoolsStreamHandle stream;
    CUgraph graph;
    void *reserved1;
} CUtoolsStreamCaptureTransitiveBegin;

// CU_TOOLS_CBID_STREAM_CAPTURE_TRANSITIVE_END
typedef struct CUtoolsStreamCaptureTransitiveEnd_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;
    CUtoolsStreamHandle stream;
    CUgraph graph;
    void *reserved1;
} CUtoolsStreamCaptureTransitiveEnd;

// -----------------------------------------------------------------------------
// CU_TOOLS_CB_DOMAIN_FIFO
// -----------------------------------------------------------------------------

// The callbacks allow us to trace timing of modifications to CPU Put
// and GPU Put. Also we have callback when pushbuffer creation on
// channel is completed. At this point we could safely modify or
// replace it. 

typedef enum CUtools_cbid_fifo_enum
{
   CU_TOOLS_CBID_FIFO_INVALID                               = 0x000,
   CU_TOOLS_CBID_FIFO_CPU_PUT_START                         = 0x001,
   CU_TOOLS_CBID_FIFO_CPU_PUT_END                           = 0x002,
   CU_TOOLS_CBID_FIFO_GPU_PUT_START                         = 0x003,
   CU_TOOLS_CBID_FIFO_GPU_PUT_END                           = 0x004,
   CU_TOOLS_CBID_FIFO_PUSHBUFFER_CREATE                     = 0x005,
   // --- always add new constants to the end here ---
   CU_TOOLS_CBID_FIFO_SIZE,
   CU_TOOLS_CBID_FIFO_FORCE_INT                             = 0x7fffffff
} CUtools_cbid_fifo;

typedef struct CUtoolsFifoCommon_st
{
   uint32_t  struct_size;
   uint32_t  tsgGroup;                // Time Slice Group 
   CUcontext ctx;                     // size is sizeof(void*)
   void      *pushBuffer;             // pointer to a pushbuffer in sysmem
   uint32_t  pushBufferLength;        // length of pushbuffer in bytes
   uint32_t  channelID;               // Channel ID (HW channel ID from CUnvchannel_st)
   uint32_t  channelType;             // Channel Type (enum CUtools_channel_type)
   // All following parameters are in range 0 - number of GPFIFO entries. (number is et by driver model)
   uint32_t  cpuPut;                  // gpfifo CPU Put as visible by GPU
   uint32_t  gpuPut;                  // gpfifo GPU Put as visible by GPU.
   uint32_t  gpuGet;                  // gpfifo GPU get as visible by CPU. It gets resynced with GPU only when needed.
} CUtoolsFifoCommon;

typedef CUtoolsFifoCommon CUtoolsFifoCpuPutStart;
typedef CUtoolsFifoCommon CUtoolsFifoCpuPutEnd;
typedef CUtoolsFifoCommon CUtoolsFifoGpuPutStart;
typedef CUtoolsFifoCommon CUtoolsFifoGpuPutEnd;

typedef struct CUtoolsFifoPushbufferCreate_st
{
   uint32_t  struct_size;
   uint32_t  tsgGroup;                // Time Slice Group 
   CUcontext ctx;                     // size is sizeof(void*)
   void      *pushBuffer;             // pointer to a pushbuffer in sysmem
   uint32_t  pushBufferLength;        // length of pushbuffer in bytes
   uint32_t  channelID;               // Channel ID (HW channel ID from CUnvchannel_st)
   uint32_t  channelType;             // Channel Type (enum CUtools_channel_type)
   // All following parameters are in range 0 - number of GPFIFO entries. (number is set by driver model)
   uint32_t  cpuPut;                  // gpfifo CPU Put as visible by GPU
   uint32_t  gpuPut;                  // gpfifo GPU Put as visible by GPU.
   uint32_t  gpuGet;                  // gpfifo GPU get as visible by CPU. It gets resynced with GPU only when needed. 
} CUtoolsFifoPushbufferCreate;

// ---------------------------- Callback Control ---------------------------------

typedef int32_t CUtoolsCbSubscriberHandle;

// Generic type capable of storing callback ids from any domain
typedef uint32_t CUtoolsCbId;

// Common type of all callbacks.  The values of domain and cbid indicate what type
// you can cast pParams to.  userdata is the same address passed to Subscribe.
typedef void (CUDAAPI *CUtoolsCbFunc)(
    void *userdata,
    CUtools_cb_domain domain,
    CUtoolsCbId cbid,
    const void *pParams);

typedef struct CUtoolsCallbackDescriptor_st
{
    CUtoolsCbId cbid;  // Callback ID - may not be sequential, but should be
                       // close enough that lookup tables can be implemented
                       // as arrays where indices represent callback IDs.

    const char *name;  // Not necessarily provided.  Useful for providing
                       // compatibility with unknown future callbacks, such
                       // as API trace.

    // Note: this structure is not extensible.
} CUtoolsCallbackDescriptor;

typedef const CUtools_cb_domain *CUtoolsCallbackDomainTable;
typedef const CUtoolsCallbackDescriptor *const *CUtoolsCallbackDescriptorTable;

CU_DEFINE_UUID(CU_ETID_ToolsCallbackControl,
    0xd80a8e2c, 0x1007, 0x4eab, 0x90, 0xdd, 0x54, 0x71, 0x9f, 0xe5, 0xf7, 0x4b);

typedef struct CUetblToolsCallbackControl_st
{
    /// This export table supports versioning by adding to the end without changing
    /// the ETID.  The struct_size field will always be set to the size in bytes of
    /// the entire export table structure.
    size_t struct_size;
    
    /// Retrieves an array of the domains supported by this version of the driver.
    /// @param pDomainCount = Out param, number of supported domains.
    /// @param pDomainList = Out param, address of an array of supported domains.
    /// @return CUDA_SUCCESS if this function is implemented.
    CUresult (CUDAAPI *SupportedDomains)(
        size_t *pDomainCount,
        CUtoolsCallbackDomainTable *pDomainTable);

    /// Returns CUDA_SUCCESS if supported.
    /// Retrieves an array of the domains supported by this version of the driver.
    /// @param domain = Domain to query.
    /// @param pCallbackCount = Out param, number of supported callbacks in domain.
    /// @param pCallbackList = Out param, address of an array of supported callbacks in domain.
    CUresult (CUDAAPI *SupportedCallbacksInDomain)(
        size_t *pCallbackCount,
        CUtoolsCallbackDescriptorTable *pCallbackDescriptorTable,
        CUtools_cb_domain domain);

    /// Subscribe for callbacks for a specific domain.
    /// Subscribing and enabling are controlled independently, and per subscriber.
    /// All callbacks are disabled by default when a new subscription is made.
    /// @param callback Client's callback function pointer.
    /// @param userdata When the callback is invoked, this value is passed in as
    ///     the callback's 'userdata' parameter.  Analogous to the client's 'this' pointer.
    /// @return A subscriberId is returned.  subscriberId must be tracked by the client.
    /// threadsafety: safe to call any time
    CUresult (CUDAAPI *Subscribe)(
        CUtoolsCbSubscriberHandle *pSubscriberHandle,
        CUtoolsCbFunc callback,
        void *userdata);

    /// @return Returns CUDA_SUCCESS if this invocation was responsible for
    ///     removing the subscription.
    /// threadsafety: safe to call any time.  You are guaranteed to receive no
    /// future callbacks after Unsubscribe has returned.
    CUresult (CUDAAPI *Unsubscribe)(
        CUtoolsCbSubscriberHandle subscriberHandle);

    /// Gets or Sets whether the specified {subscriber, area, cbid} is enabled.
    /// Enable or disable a callback for the specified {subscriber, area, cbid}.
    /// threadsafety: Multiple subscribers may call concurrently, but each
    ///     subscriber must serialize access to Get and Set.  In other words:
    ///        If GetCallbackEnabled(sub, d, c) and SetCallbackEnabled(sub, d, c) are
    ///        called concurrently, the results are undefined.
    CUresult (CUDAAPI *CallbackEnabled)(
        uint32_t *pEnabled,
        CUtoolsCbSubscriberHandle subscriberHandle, 
        CUtools_cb_domain domain, 
        CUtoolsCbId cbid);

    CUresult (CUDAAPI *EnableCallback)(
        uint32_t enable,
        CUtoolsCbSubscriberHandle subscriberHandle, 
        CUtools_cb_domain domain, 
        CUtoolsCbId cbid);

    CUresult (CUDAAPI *EnableAllCallbacksInDomain)(
        uint32_t enable,
        CUtoolsCbSubscriberHandle subscriberHandle, 
        CUtools_cb_domain domain);

    CUresult (CUDAAPI *EnableAllCallbacks)(
        uint32_t enable,
        CUtoolsCbSubscriberHandle subscriberHandle);

} CUetblToolsCallbackControl;


#ifdef __cplusplus
} // extern "C"
#endif

