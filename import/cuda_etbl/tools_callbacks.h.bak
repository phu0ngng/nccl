// -----------------------------------------------------------------------------
// CU_TOOLS_CB_DOMAIN_TRACE_API_CUDA
// -----------------------------------------------------------------------------

#define CU_TOOLS_DEFINE_ENUM_CBID_TRACE_API_CUDA(area, id, name, params) \
    CU_TOOLS_CBID_TRACE_API_CUDA_ ## name,

typedef enum CUtools_cbid_trace_api_cuda_enum {
    CU_TOOLS_CBID_TRACE_API_CUDA_INVALID = 0,

    // Generate enum value for each API function, for example:
    // CU_TOOLS_CBID_TRACE_API_CUDA_cuCtxCreate = 10,
    // CU_TOOLS_CBID_TRACE_API_CUDA_cuCtxDestroy = 11,
    // ...
    CU_TOOLS_FOR_EACH_CUDA_API_FUNC( CU_TOOLS_DEFINE_ENUM_CBID_TRACE_API_CUDA )

    CU_TOOLS_CBID_TRACE_API_CUDA_SIZE,
    CU_TOOLS_CBID_TRACE_API_CUDA_FORCE_INT = 0x7fffffff
} CUtools_cbid_trace_api_cuda;

typedef enum CUtools_api_enter_exit_enum {
    CU_TOOLS_API_ENTER                      = 0,
    CU_TOOLS_API_EXIT                       = 1,
    CU_TOOLS_API_ENTER_EXIT_FORCE_INT       = 0x7fffffff
} CUtools_api_enter_exit;

// Driver API enter/exit callback params struct, shared by
// all callbacks in domain CU_TOOLS_CB_DOMAIN_TRACE_API_CUDA
// e.g. CU_TOOLS_CBID_TRACE_API_CUDA_cuCtxCreate.
// Note that "params" is different per function.  Cast to
// appropriate struct in the generated_cuda*_meta.h files.
// If cbid == CU_TOOLS_CBID_TRACE_API_CUDA_cuLaunchKernel,
// use (cuLaunchKernel_params*)params.
typedef struct CUtoolsTraceApiCuda_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    uint64_t contextId;             // Incrementing ID, unique per process
    uint64_t streamId;              // DEPRECATED - This parameter will always be zero
    uint64_t apiCallId;             // DEPRECATED - This parameter will not be set

    uint64_t *pCorrelationId;       // In/out parameter for tools to correlate enter/exit callbacks
    CUresult *pStatus;              // In/out parameter for tools to check or override returned status

    const char *functionName;
    void *params;

    CUcontext ctx;                  // size is sizeof(void*)
    CUtoolsStreamHandle stream;     // DEPRECATED - This parameter will always be zero

    uint32_t functionId;            // Identical to callback's cbid.

    CUtools_api_enter_exit apiEnterOrExit;

    // Out parameter:  Defaults to zero, but if the tool sets this to a non-zero value,
    // the driver's implementation of the function will be skipped.  This is useful if
    // the tool wants to implement the function differently using the API enter callback.
    // The API exit callback is still called.
    uint32_t *pSkipInternalImplementation;

    void *reserved1;

} CUtoolsTraceApiCuda;

// -----------------------------------------------------------------------------
// CU_TOOLS_CB_DOMAIN_TRACE_API_CUDA_RUNTIME
// -----------------------------------------------------------------------------

// Runtime API enter/exit callback params struct, shared by all
// callbacks in domain CU_TOOLS_CB_DOMAIN_TRACE_API_CUDA_RUNTIME
// e.g. CU_TOOLS_CBID_TRACE_API_CUDA_RUNTIME_cudaMalloc_v3020.
// Note that "params" is different per function.  Cast to
// appropriate struct in the generated_cuda_*_meta.h files.
// If cbid == CU_TOOLS_CBID_TRACE_API_CUDA_RUNTIME_cudaMalloc_v3020,
// use (cudaMalloc_v3020_params*)params.
typedef struct CUtoolsTraceRuntimeApiCuda_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    uint64_t contextId;        // Incrementing ID, unique per process
    uint64_t streamId;         // Incrementing ID, unique per context
    uint64_t apiCallId;        // DEPRECATED - This parameter will not be set

    uint64_t *pCorrelationId;  // In/out param for tools to correlate enter/exit callbacks
    uint32_t *pStatus;         // In/out param for exit callback to get/set return value (cudaError_t)

    const char *functionName;
    const void *params;

    CUcontext ctx;             // size is sizeof(void*)
    CUstream stream;           // size is sizeof(void*) - type is equivalent to cudaStream_t

    uint32_t functionId;       // Identical to callback's cbid.
    uint32_t apiEnterOrExit;   // Use values from CUtools_api_enter_exit

    const char *symbolName;    // symbol name, currently only valid for cudaLaunch
    void *reserved1;

    // Pointer to runtime instance's __cudaGetExportTableInternal function
    CUresult (CUDAAPI *pfnGetExportTable)(
        const void **ppExportTable,
        const CUuuid *pExportTableId);
    void *reserved2;

} CUtoolsTraceRuntimeApiCuda;

