// -----------------------------------------------------------------------------
// CU_TOOLS_CB_DOMAIN_LAUNCH
// -----------------------------------------------------------------------------

// Launch callbacks
// LAUNCH_BEGIN/LAUNCH_END are guaranteed to always occur as a matching pair,
// bounding the other launch callbacks, although errors during the launch can
// cause a premature jump from any point in the sequence to LAUNCH_END.
typedef enum CUtools_cbid_launch_enum
{
    CU_TOOLS_CBID_LAUNCH_INVALID                       = 0x000,
    CU_TOOLS_CBID_LAUNCH_BEGIN                         = 0x001,
    CU_TOOLS_CBID_LAUNCH_AFTER_FUNCTION_SETUP          = 0x002,
    CU_TOOLS_CBID_LAUNCH_PUSHBUFFER_BEGIN              = 0x003,
    CU_TOOLS_CBID_LAUNCH_BEFORE_LAUNCH_PUSHED          = 0x004,
    CU_TOOLS_CBID_LAUNCH_AFTER_LAUNCH_PUSHED           = 0x005,
    CU_TOOLS_CBID_LAUNCH_PUSHBUFFER_END                = 0x006,
    CU_TOOLS_CBID_LAUNCH_AFTER_GRID_LAUNCHED           = 0x007,
    CU_TOOLS_CBID_LAUNCH_OCCUPANCY_CALCULATION         = 0x008,
    CU_TOOLS_CBID_LAUNCH_END                           = 0x009,
    CU_TOOLS_CBID_LAUNCH_AFTER_SYSCALL_SETUP           = 0x00A,

   // --- always add new constants to the end here ---
    CU_TOOLS_CBID_LAUNCH_SIZE,
    CU_TOOLS_CBID_LAUNCH_FORCE_INT                     = 0x7fffffff
} CUtools_cbid_launch;

// CU_TOOLS_CBID_LAUNCH_BEGIN
typedef struct CUtoolsLaunchBegin_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)

    //  launch-properties
    uint32_t gridDim_x;
    uint32_t gridDim_y;
    uint32_t blockDim_x;
    uint32_t blockDim_y;
    uint32_t blockDim_z;
    uint32_t gridDim_z;
    uint64_t gridId;
} CUtoolsLaunchBegin;

// CU_TOOLS_CBID_LAUNCH_OCCUPANCY_CALCULATION
typedef struct CUtoolsOccupancyCalculation_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)

    float occupancy;                   // THIS FIELD IS DEPRECATED.  This field is not initialized by driver
                                       // and should not be used. Occupancy needs to be calculated by tools
                                       // from other parameters available.
    uint32_t cacheConfigRequested;     // Cache configuration set for the function

    uint32_t regCount;
    uint32_t compilerSharedMem;
    uint32_t userSharedMem;
    uint32_t syscallSharedMem;
    uint32_t totalSharedMem;
    uint32_t maxSharedMemSizeOld;      // THIS FIELD IS DEPRECATED.  It was intended to be compared against
                                       // maxSharedMemSizeNew to check for changes in the shared mem config.
                                       // It is and has always been wrong on all architectures except Fermi,
                                       // so instead of fixing in the driver, tools should work around this
                                       // by tracking maxSharedMemSizeNew across launches within a context,
                                       // and watching for changes in that value.
    uint32_t maxSharedMemSizeNew;
    CU_32_BIT_PAD_ON_64_BIT_BUILDS(reserved1)
    uint64_t gridId;
    uint32_t steeringExpected; // C-style bool, set if the configuration indicates CTA steering was
                               // requested to be enabled.
    uint32_t steeringEnabled;  // C-style bool, set if the occupancy calculation determines CTA steering
                               // would be enabled by the hardware. Typically, steeringEnabled will have
                               // the same value as steeringExpected, except the rare case when the
                               // launch config with steering enabled would result in zero occupancy
                               // (launch failure), and with steering disabled would result in >0 occupancy
                               // (successful launch). In that case the hardware may automatically disable
                               // steering to allow a successful launch, so steeringExpected would be true
                               // and steeringEnabled would be false.
    uint32_t shmemCarveoutPreferenceIsSet; // C-style bool, If the user set shared memory carveout preference through cudaFuncSetAttribute API
    uint32_t shmemCarveoutPreference;      // If the preference is set, contains the user's preference
    uint32_t shmemExecuted;
    CU_32_BIT_PAD_ON_64_BIT_BUILDS(reserved2)

} CUtoolsOccupancyCalculation;

// CU_TOOLS_CBID_LAUNCH_AFTER_FUNCTION_SETUP
typedef struct CUtoolsAfterFunctionSetup_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)
    uint64_t gridId;
} CUtoolsAfterFunctionSetup;

// First chance to add something to the launch pushbuffer.
// CU_TOOLS_CBID_LAUNCH_PUSHBUFFER_BEGIN
typedef struct CUtoolsPushbufferBegin_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)

    CUtoolsChannelHandle hChannel;
    CUtoolsNvCurrent *pnvCurrent;
    uint64_t gridId;
} CUtoolsPushbufferBegin;

// Chance to add something to the launch pushbuffer immediately before launch.
// CU_TOOLS_CBID_LAUNCH_BEFORE_LAUNCH_PUSHED
typedef struct CUtoolsBeforeLaunchPushed_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)

    CUtoolsChannelHandle hChannel;
    CUtoolsNvCurrent *pnvCurrent;
    uint64_t gridId;
} CUtoolsBeforeLaunchPushed;

// Chance to add something to the launch pushbuffer immediately after launch.
// CU_TOOLS_CBID_LAUNCH_AFTER_LAUNCH_PUSHED
typedef struct CUtoolsAfterLaunchPushed_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)

    CUtoolsChannelHandle hChannel;
    CUtoolsNvCurrent *pnvCurrent;
    uint64_t gridId;
} CUtoolsAfterLaunchPushed;

// Last chance to add something to the launch pushbuffer.
// CU_TOOLS_CBID_LAUNCH_PUSHBUFFER_END
typedef struct CUtoolsPushbufferEnd_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)

    CUtoolsChannelHandle hChannel;
    CUtoolsNvCurrent *pnvCurrent;
    uint64_t gridId;
} CUtoolsPushbufferEnd;

// CU_TOOLS_CBID_LAUNCH_AFTER_GRID_LAUNCHED
typedef struct CUtoolsAfterGridLaunched_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)
    uint64_t gridId;
} CUtoolsAfterGridLaunched;

// CU_TOOLS_CBID_LAUNCH_END
typedef struct CUtoolsLaunchEnd_st
{
    uint32_t struct_size;
    uint32_t status;                   // CUresult at exit of launch implementation
    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)
    uint64_t gridId;
} CUtoolsLaunchEnd;

// CU_TOOLS_CBID_LAUNCH_AFTER_SYSCALL_SETUP
typedef struct CUtoolsAfterSyscallSetup_st
{
    uint32_t struct_size;
    uint32_t reserved0;
    CUcontext ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    CUmodule mod;                      // size is sizeof(void*)
    CUfunction func;                   // size is sizeof(void*)
    uint64_t gridId;
} CUtoolsAfterSyscallSetup;


// -----------------------------------------------------------------------------
// CU_TOOLS_CB_DOMAIN_MEMCPY
// -----------------------------------------------------------------------------

// Memcpy callbacks
// MEMCPY_BEGIN/MEMCPY_END are guaranteed to always occur as a matching pair,
// bounding the other memcpy callbacks, although errors during the memcpy can
// cause a premature jump from any point in the sequence to MEMCPY_END.
typedef enum CUtools_cbid_memcpy_enum
{
    CU_TOOLS_CBID_MEMCPY_INVALID                       = 0x000,
    CU_TOOLS_CBID_MEMCPY_BEGIN                         = 0x001,
    CU_TOOLS_CBID_MEMCPY_PUSH_BEGIN                    = 0x002,
    CU_TOOLS_CBID_MEMCPY_PUSH_END                      = 0x003,
    CU_TOOLS_CBID_MEMCPY_END                           = 0x004,
    CU_TOOLS_CBID_MEMCPY_KERNEL_BEGIN                  = 0x005,
    CU_TOOLS_CBID_MEMCPY_KERNEL_END                    = 0x006,
    CU_TOOLS_CBID_MEMCPY_HOST_WAIT_BEGIN               = 0x007,
    CU_TOOLS_CBID_MEMCPY_HOST_WAIT_END                 = 0x008,
    // --- always add new constants to the end here ---
    CU_TOOLS_CBID_MEMCPY_SIZE,
    CU_TOOLS_CBID_MEMCPY_FORCE_INT                     = 0x7fffffff
} CUtools_cbid_memcpy;

typedef enum CUtoolsMemcpyDir_enum
{
    CU_TOOLS_MEMCPY_DIR_INVALID   = 0x000,
    CU_TOOLS_MEMCPY_DIR_H_TO_D    = 0x001,
    CU_TOOLS_MEMCPY_DIR_D_TO_H    = 0x002,
    CU_TOOLS_MEMCPY_DIR_H_TO_A    = 0x003,
    CU_TOOLS_MEMCPY_DIR_A_TO_H    = 0x004,
    CU_TOOLS_MEMCPY_DIR_A_TO_A    = 0x005,
    CU_TOOLS_MEMCPY_DIR_A_TO_D    = 0x006,
    CU_TOOLS_MEMCPY_DIR_D_TO_A    = 0x007,
    CU_TOOLS_MEMCPY_DIR_D_TO_D    = 0x008,
    CU_TOOLS_MEMCPY_DIR_H_TO_H    = 0x009,
    // --- always add new constants to the end here ---
    CU_TOOLS_MEMCPY_DIR_SIZE,
    CU_TOOLS_MEMCPY_DIR_INT       = 0x7fffffff
} CUtoolsMemcpyDir;

typedef enum CUtoolsMemcpyObjectType_enum
{
    CU_TOOLS_MEMCPY_OBJECT_TYPE_INVALID              = 0x000,
    CU_TOOLS_MEMCPY_OBJECT_TYPE_HOST_PAGEABLE        = 0x001,
    CU_TOOLS_MEMCPY_OBJECT_TYPE_HOST_PINNED          = 0x002,
    CU_TOOLS_MEMCPY_OBJECT_TYPE_DEVICE               = 0x003,
    CU_TOOLS_MEMCPY_OBJECT_TYPE_ARRAY                = 0x004,
    // --- always add new constants to the end here ---
    CU_TOOLS_MEMCPY_OBJECT_TYPE_SIZE,
    CU_TOOLS_MEMCPY_OBJECT_TYPE_INT           = 0x7fffffff
} CUtoolsMemcpyObjectType;

// CU_TOOLS_CBID_MEMCPY_BEGIN
typedef struct CUtoolsMemcpyBegin_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    // In typical case, these are the ctx/stream the memcpy occurs on.
    // In P2H2P case, these are the H2P (destination) ctx/stream, and
    // use srcCtx/srcStream below for P2H (source) ctx/stream.
    CUcontext ctx;                              // size is sizeof(void*)
    CUtoolsStreamHandle stream;                 // size is sizeof(void*)

    // Transfer Configuration
    uint64_t                bytes;
    uint32_t                direction;          // Of type CUtoolsMemcpyDir
    uint32_t                isAsync;
    uint32_t                isApiRequested;

    // Source Details
    CUtoolsMemcpyObjectType srcType;
    CUtoolsMemObjHandle     srcObject;
    CU_32_BIT_PAD_ON_32_BIT_BUILDS(reserved1)
    uint64_t                srcOffset;
    uint64_t                srcVaddr;

    // Destination Details
    CUtoolsMemObjHandle     dstObject;
    CU_32_BIT_PAD_ON_32_BIT_BUILDS(reserved2)
    uint64_t                dstOffset;
    uint64_t                dstVaddr;
    CUtoolsMemcpyObjectType dstType;
    uint32_t                reserved3;

    // Additional Source Details
    CUcontext srcCtx;                           // size is sizeof(void*)
    CUtoolsStreamHandle srcStream;              // size is sizeof(void*)

    // User-requested Stream Details
    // Source and dest may both be different from the stream the
    // copy was originally requested on.  Include the requested-on
    // stream so the tool can know the stream where the operation
    // was semantically intended to occur.
    CUcontext requestedOnCtx;                   // size is sizeof(void*)
    CUtoolsStreamHandle requestedOnStream;      // size is sizeof(void*)

} CUtoolsMemcpyBegin;

// CU_TOOLS_CBID_MEMCPY_PUSH_BEGIN
typedef struct CUtoolsMemcpyPushBegin_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    CUcontext                 ctx;             // size is sizeof(void*)
    CUtoolsStreamHandle       stream;          // size is sizeof(void*)

    uint64_t                  bytes;

    CUtoolsChannelHandle      hChannel;
    CUtoolsNvCurrent         *pnvCurrent;

    CUtools_channel_type      channelType;
    CUtools_engine_type       engineType;
} CUtoolsMemcpyPushBegin;

// CU_TOOLS_CBID_MEMCPY_PUSH_END
typedef struct CUtoolsMemcpyPushEnd_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    CUcontext                 ctx;              // size is sizeof(void*)
    CUtoolsStreamHandle       stream;           // size is sizeof(void*)

    CUtoolsChannelHandle      hChannel;
    CUtoolsNvCurrent         *pnvCurrent;

    CUtools_channel_type      channelType;
    CUtools_engine_type       engineType;
} CUtoolsMemcpyPushEnd;

// CU_TOOLS_CBID_MEMCPY_END
typedef struct CUtoolsMemcpyEnd_st
{
    uint32_t            struct_size;
    uint32_t            reserved0;

    CUcontext           ctx;                     // size is sizeof(void*)
    CUtoolsStreamHandle stream;        // size is sizeof(void*)
    uint32_t            status;
    uint32_t            reserved1;

    uint32_t            direction;      // Type is actually CUtoolsMemcpyDir
    uint32_t            isAsync;
    uint32_t            isApiRequested;
    uint32_t            reserved2;
} CUtoolsMemcpyEnd;

// CU_TOOLS_CBID_MEMCPY_KERNEL_BEGIN
typedef struct CUtoolsMemcpyKernelBegin_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    CUcontext                 ctx;            // size is sizeof(void*)
    CUtoolsStreamHandle       stream;         // size is sizeof(void*)

    uint64_t                  bytes;
} CUtoolsMemcpyKernelBegin;

// CU_TOOLS_CBID_MEMCPY_KERNEL_END
typedef struct CUtoolsMemcpyKernelEnd_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    CUcontext                 ctx;            // size is sizeof(void*)
    CUtoolsStreamHandle       stream;         // size is sizeof(void*)
} CUtoolsMemcpyKernelEnd;

// CU_TOOLS_CBID_MEMCPY_HOST_WAIT_BEGIN
typedef struct CUtoolsMemcpyHostWaitBegin_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    CUcontext                 ctx;            // size is sizeof(void*)
    CUtoolsStreamHandle       stream;         // size is sizeof(void*)
} CUtoolsMemcpyHostWaitBegin;

// CU_TOOLS_CBID_MEMCPY_HOST_WAIT_END
typedef struct CUtoolsMemcpyHostWaitEnd_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    CUcontext                 ctx;            // size is sizeof(void*)
    CUtoolsStreamHandle       stream;         // size is sizeof(void*)
} CUtoolsMemcpyHostWaitEnd;

// -----------------------------------------------------------------------------
// CU_TOOLS_CB_DOMAIN_MEMSET
// -----------------------------------------------------------------------------

// Memory Set callbacks.
// MEMSET_SETUP_INIT, MEMSET_SETUP_BEGIN, and MEMSET_SETUP_END are guaranteed to
// always occur as a sequence (in that order), regardless of errors.
typedef enum CUtools_cbid_memset_enum
{
    CU_TOOLS_CBID_MEMSET_INVALID                       = 0x000,
    CU_TOOLS_CBID_MEMSET_SETUP_BEGIN                   = 0x001,
    CU_TOOLS_CBID_MEMSET_SETUP_END                     = 0x002,
    CU_TOOLS_CBID_MEMSET_SETUP_INIT                    = 0x003,
    // --- always add new constants to the end here ---
    CU_TOOLS_CBID_MEMSET_SIZE,
    CU_TOOLS_CBID_MEMSET_FORCE_INT                     = 0x7fffffff
} CUtools_cbid_memset;

typedef enum CUtoolsMemsetMode_enum
{
    CU_TOOLS_MEMSET_MODE_INVALID            = 0x000,
    CU_TOOLS_MEMSET_MODE_SET8               = 0x001,
    CU_TOOLS_MEMSET_MODE_SET16              = 0x002,
    CU_TOOLS_MEMSET_MODE_SET32              = 0x003,
    CU_TOOLS_MEMSET_MODE_SET32_ALIGNED_1D   = 0x004,
    // --- always add new constants to the end here ---
    CU_TOOLS_MEMSET_MODE_SIZE,
    CU_TOOLS_MEMSET_MODE_INT                = 0x7fffffff
} CUtoolsMemsetMode;

// CU_TOOLS_CBID_MEMSET_SETUP_INIT
typedef struct CUtoolsMemsetSetupInit_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    CUcontext ctx;                              // size is sizeof(void*)
    CUtoolsStreamHandle stream;                 // size is sizeof(void*)

    // Set Object
    CUtoolsMemObjHandle  deviceObject;          // size is sizeof(void*)
    CU_32_BIT_PAD_ON_32_BIT_BUILDS(reserved1)
    uint64_t             devicePointer;
    uint32_t             deviceOffset;

    // API or internal
    uint32_t             isApiRequested;

    // Set Descriptor
    uint64_t             width;
    uint64_t             height;
    uint64_t             pitch;
    uint32_t             elementSize;
    uint32_t             value;
    uint32_t             isAsync;
    uint32_t             reserved2;
} CUtoolsMemsetSetupInit;

// CU_TOOLS_CBID_MEMSET_SETUP_BEGIN
typedef struct CUtoolsMemsetSetupBegin_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    CUcontext ctx;                              // size is sizeof(void*)
    CUtoolsStreamHandle stream;                 // size is sizeof(void*)

    // Set Object
    CUtoolsMemObjHandle  deviceObject;          // size is sizeof(void*)
    CU_32_BIT_PAD_ON_32_BIT_BUILDS(reserved1)
    uint64_t             devicePointer;
    uint32_t             deviceOffset;
    
    // Set Execution Configuration
    CUtoolsMemsetMode    mode;                  // size is 4 bytes
    uint64_t             bytes;
    uint32_t             value;
    uint32_t             numKernelCalls;
    CUtoolsChannelHandle hChannel;
    CUtoolsNvCurrent     *pnvCurrent;
    CUtools_engine_type  engineType;
    uint32_t reserved2;
} CUtoolsMemsetSetupBegin;

// CU_TOOLS_CBID_MEMSET_SETUP_END
typedef struct CUtoolsMemsetSetupEnd_st
{
    uint32_t struct_size;
    uint32_t reserved0;

    CUcontext ctx;                               // size is sizeof(void*)
    CUtoolsStreamHandle stream;                  // size is sizeof(void*)
    uint32_t status;
    uint32_t reserved1;
    CUtoolsChannelHandle hChannel;
    CUtoolsNvCurrent     *pnvCurrent;
    CUtools_engine_type  engineType;
    uint32_t reserved2;
} CUtoolsMemsetSetupEnd;

