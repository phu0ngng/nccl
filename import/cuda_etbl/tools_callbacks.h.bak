{
    CU_TOOLS_DEVICE_ORDER_INVALID                 = 0x000,
    CU_TOOLS_DEVICE_ORDER_BEGIN                   = 0x001,
    CU_TOOLS_DEVICE_ORDER_END                     = 0x002,
    CU_TOOLS_DEVICE_ORDER_APP_PROFILE             = 0x003,
    CU_TOOLS_DEVICE_ORDER_FASTEST_FIRST           = 0x004,
    CU_TOOLS_DEVICE_ORDER_PCI_BUS_ID              = 0x005,
    CU_TOOLS_DEVICE_ORDER_KEEP_SIMULATED          = 0x006,
    CU_TOOLS_DEVICE_ORDER_VISIBLE_DEVICES         = 0x007,
    CU_TOOLS_DEVICE_ORDER_KEEP_DEBUGGABLE         = 0x008,
    // --- always add new constants to the end here ---
    CU_TOOLS_DEVICE_ORDER_SIZE,
    CU_TOOLS_DEVICE_ORDER_FORCE_INT               = 0x7fffffff
} CUtools_device_order;

typedef struct CUtoolsDeviceRemap_st
{
    uint32_t struct_size;
    uint32_t status;
    uint32_t *pRemapTable;
    uint32_t *pNewNumDevices;
    uint32_t remapTableSize;
    uint32_t step;
    uint32_t *pRemappingHandled;
    void *reserved0;
} CUtoolsDeviceRemap;

