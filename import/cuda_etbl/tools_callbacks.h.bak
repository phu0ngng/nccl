// Callbacks are organized into domains, and within each domain the
// callback ids are contiguous.  Zero is invalid for both domain and
// callback ids.  None of these ids may change without changing the
// uuid of the tools_callbacks export table.  Due to that rule, the
// order in which the callbacks occur may not correlate to their
// cbid values.
typedef enum CUtools_cb_domain_enum
{
    CU_TOOLS_CB_DOMAIN_INVALID                          = 0x000,
    CU_TOOLS_CB_DOMAIN_INIT                             = 0x001,
    CU_TOOLS_CB_DOMAIN_RESOURCE                         = 0x002,
    CU_TOOLS_CB_DOMAIN_LAUNCH                           = 0x003,
    CU_TOOLS_CB_DOMAIN_PROFILER                         = 0x004,
    CU_TOOLS_CB_DOMAIN_SYNCHRONIZE                      = 0x005,
    CU_TOOLS_CB_DOMAIN_TRACE_API_CUDA                   = 0x006,
    CU_TOOLS_CB_DOMAIN_TRACE_API_CUDA_RUNTIME           = 0x007,
    CU_TOOLS_CB_DOMAIN_MEMCPY                           = 0x008,
    CU_TOOLS_CB_DOMAIN_MEMSET                           = 0x009,
    CU_TOOLS_CB_DOMAIN_TRAP                             = 0x00a,
    CU_TOOLS_CB_DOMAIN_QMD                              = 0x00b,
    CU_TOOLS_CB_DOMAIN_TRACE_API_CUDA_ETBL              = 0x00c,
    CU_TOOLS_CB_DOMAIN_RESOURCE_INTERNAL                = 0x00d,
    CU_TOOLS_CB_DOMAIN_UVM_LITE                         = 0x00e,
    CU_TOOLS_CB_DOMAIN_CUDA_RUNTIME_INTERNAL            = 0x00f,
    CU_TOOLS_CB_DOMAIN_BATCH_MEMOP                      = 0x010,
    CU_TOOLS_CB_DOMAIN_STREAM_CAPTURE                   = 0x011,
    CU_TOOLS_CB_DOMAIN_FIFO                             = 0x012,

    // --- always add new constants to the end here ---
    CU_TOOLS_CB_DOMAIN_SIZE,
    CU_TOOLS_CB_DOMAIN_FORCE_INT                        = 0x7fffffff
} CUtools_cb_domain;

